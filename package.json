{
  "name": "talal-tailor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Talal Tailor — an applicant tracking system proof of concept built with Svelte",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:artifact": "vite build && node scripts/build-artifact.mjs",
    "gen:metrics": "node scripts/extract-font-metrics.mjs",
    "gen:avatars": "node scripts/fetch-avatars.mjs",
    "gen:seed": "node scripts/export-seed.mjs",
    "check": "svelte-check --threshold warning"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.9",
    "@pdf-lib/standard-fonts": "^1.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "pdfjs-dist": "^6.3.289",
    "playwright": "^1.63.0",
    "sharp": "^0.35.4",
    "svelte": "^5.57.0",
    "svelte-check": "^4.3.3",
    "vite": "^8.3.0"
  }
}
